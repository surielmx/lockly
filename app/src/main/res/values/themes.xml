<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Lockly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/ic_lock_lock</item>
        <item name="postSplashScreenTheme">@style/Theme.Lockly</item>
    </style>
</resources>